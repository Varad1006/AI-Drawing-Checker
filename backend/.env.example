# Copy to backend/.env and fill in. Everything is optional: without a key the app runs on the
# deterministic rule engine and the offline chat command parser.
GROQ_API_KEY=
# Any Groq chat model with tool calling, e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
# Run the AI review automatically after each upload
AI_REVIEW_ON_UPLOAD=true
# DATA_DIR=../data
# MAX_UPLOAD_MB=25
# CORS_ORIGINS=http://localhost:5173
